{
  "name": "wittymediaclient-desktop",
  "productName": "WittyMedia",
  "version": "0.2.0",
  "description": "WittyMediaClient for Windows, Linux and FreeBSD",
  "author": "WittyWilla",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wittywilla/WittyMediaClient",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "start": "npm run sync && electron .",
    "test": "npm run sync && node --test ../shared/connect/address.test.js test/state.test.js test/connect.test.js test/guards.test.js test/pages.test.js test/moonlight.test.js test/clientlog.test.js test/tv.test.js test/freebsd.test.js",
    "test:app": "npm run sync && node test/app/all.js",
    "package:win": "npm run sync && electron-builder --win",
    "package:linux": "npm run sync && electron-builder --linux",
    "test:real": "npm run sync && electron test/app/real-server.js",
    "package:freebsd": "npm run sync && node packaging/freebsd/package.mjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.wittywilla.wittymediaclient",
    "productName": "WittyMedia",
    "directories": {
      "output": "out"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "state.js",
      "identity.js",
      "guards.js",
      "discover.js",
      "moonlight.js",
      "clientlog.js",
      "tv.js",
      "titlebar/**",
      "connect/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": null,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "executableName": "wittymedia",
      "category": "AudioVideo",
      "maintainer": "WittyWilla",
      "synopsis": "Watch and listen to your own WittyMediaServer",
      "desktop": {
        "entry": {
          "Name": "WittyMedia",
          "GenericName": "Media player",
          "Comment": "Watch and listen to your own WittyMediaServer",
          "Categories": "AudioVideo;Video;Audio;Player;TV;",
          "Keywords": "media;video;music;television;server;",
          "Terminal": "false",
          "StartupWMClass": "wittymedia"
        }
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "multicast-dns": "7.2.5"
  },
  "desktopName": "wittymedia.desktop"
}
