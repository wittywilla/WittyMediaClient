{
  "name": "wittymediaclient",
  "productName": "WittyMediaClient",
  "desktopName": "wittymediaclient.desktop",
  "version": "0.6.0",
  "description": "Watch and listen from your WittyMediaServer",
  "author": "WittyWilla",
  "homepage": "https://github.com/wittywilla/WittyMediaClient",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "build:connect": "node scripts/build-wittyconnect.mjs",
    "test:p2p": "npm run sync && echo 'see test/app/p2p-real.js for what to set' && electron test/app/p2p-real.js",
    "start": "npm run sync && electron .",
    "test": "npm run sync && node --test ../shared/connect/address.test.js ../shared/connect/qr.test.js test/state.test.js test/servers.test.js test/connect.test.js test/guards.test.js test/pages.test.js test/moonlight.test.js test/clientlog.test.js test/tv.test.js test/playback.test.js test/mac.test.js test/freebsd.test.js test/p2p.test.js test/code.test.js",
    "test:app": "npm run sync && node test/app/all.js",
    "package:win": "npm run sync && node scripts/build-wittyconnect.mjs win-x64 --if-available && electron-builder --win",
    "package:linux": "npm run sync && node scripts/build-wittyconnect.mjs linux-x64 --if-available && electron-builder --linux",
    "package:flatpak": "npm run sync && node scripts/build-wittyconnect.mjs linux-x64 --if-available && electron-builder --linux flatpak --x64",
    "package:snap": "npm run sync && node scripts/build-wittyconnect.mjs linux-x64 --if-available && node scripts/package-snap.mjs",
    "package:mac": "npm run sync && node scripts/build-wittyconnect.mjs mac-arm64 --if-available && node scripts/build-wittyconnect.mjs mac-x64 --if-available && electron-builder --mac",
    "test:real": "npm run sync && electron test/app/real-server.js",
    "package:freebsd": "npm run sync && node build/freebsd/package.mjs"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.wittywilla.wittymediaclient",
    "productName": "WittyMediaClient",
    "copyright": "Copyright 2026 WittyWilla and contributors",
    "directories": {
      "output": "out",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "state.js",
      "identity.js",
      "guards.js",
      "discover.js",
      "moonlight.js",
      "clientlog.js",
      "tv.js",
      "playback.js",
      "mac.js",
      "p2p.js",
      "code.js",
      "servers.js",
      "titlebar/**",
      "connect/**"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "bin/${os}-${arch}",
        "to": ".",
        "filter": [
          "wittyconnect",
          "wittyconnect.exe",
          "THIRD-PARTY-NOTICES.wittyconnect.txt"
        ]
      }
    ],
    "publish": null,
    "npmRebuild": false,
    "afterPack": "build/after-pack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "WittyMediaClient"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WittyMediaClient",
      "uninstallDisplayName": "WittyMediaClient",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false,
      "artifactName": "wittymediaclient-${version}-windows-amd64-setup.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "artifactName": "wittymediaclient-${version}-macos-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/mac/Uninstall WittyMediaClient.command",
          "to": "Uninstall WittyMediaClient.command"
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "WittyMediaClient ${version}",
      "window": {
        "width": 540,
        "height": 400
      },
      "contents": [
        {
          "x": 140,
          "y": 150,
          "type": "file",
          "name": "WittyMediaClient.app"
        },
        {
          "x": 400,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 300,
          "type": "file",
          "path": "build/mac/Uninstall WittyMediaClient.command",
          "name": "Uninstall WittyMediaClient.command"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo;Video;Audio;Player;TV;",
      "maintainer": "WittyWilla",
      "executableName": "wittymediaclient",
      "synopsis": "Connect to your WittyMediaServer",
      "desktop": {
        "entry": {
          "Name": "WittyMediaClient",
          "GenericName": "Media player",
          "Keywords": "media;video;music;television;server;",
          "Terminal": "false",
          "StartupWMClass": "wittymediaclient"
        }
      },
      "syncDesktopName": true,
      "description": "Connect to your WittyMediaServer"
    },
    "appImage": {
      "artifactName": "wittymediaclient-${version}-linux-amd64.${ext}"
    },
    "deb": {
      "artifactName": "wittymediaclient-${version}-linux-amd64.${ext}",
      "packageName": "wittymediaclient",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libnspr4",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libatk1.0-0t64 | libatk1.0-0",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libcups2t64 | libcups2",
        "libdrm2",
        "libgbm1",
        "libasound2t64 | libasound2",
        "libxkbcommon0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": []
    },
    "rpm": {
      "artifactName": "wittymediaclient-${version}-linux-amd64.${ext}",
      "packageName": "wittymediaclient",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "nspr",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "at-spi2-atk",
        "atk",
        "cups-libs",
        "libdrm",
        "mesa-libgbm",
        "alsa-lib",
        "libxkbcommon",
        "libuuid",
        "libsecret"
      ]
    },
    "pacman": {
      "artifactName": "wittymediaclient-${version}-linux-amd64.${ext}",
      "packageName": "wittymediaclient",
      "afterRemove": "build/linux/after-remove.sh",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "nspr",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "libcups",
        "libdrm",
        "mesa",
        "alsa-lib",
        "libxkbcommon",
        "util-linux-libs",
        "libsecret"
      ]
    },
    "flatpak": {
      "artifactName": "wittymediaclient-${version}-linux-amd64.${ext}",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--share=network",
        "--socket=pulseaudio",
        "--device=all",
        "--filesystem=xdg-download",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.freedesktop.PowerManagement",
        "--talk-name=org.gnome.SessionManager",
        "--own-name=org.mpris.MediaPlayer2.chromium.*"
      ]
    },
    "snapcraft": {
      "base": "core24",
      "artifactName": "wittymediaclient-${version}-linux-amd64.${ext}",
      "core24": {
        "useLXD": true,
        "summary": "Watch and listen from your WittyMediaServer",
        "plugs": [
          "default",
          "browser-support",
          "network-bind",
          "joystick"
        ]
      }
    },
    "asar": true
  },
  "dependencies": {
    "multicast-dns": "7.2.5"
  }
}
