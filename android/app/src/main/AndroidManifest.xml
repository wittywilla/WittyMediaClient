<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To try playback again as soon as a dropped network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Music, audiobooks and podcasts carry on with the screen off and the app left. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A game's rumble, on the controller that plays it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- New notifications from the server, in the phone's own list while the app is open: off until turned on (Notes.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- An Android TV's home screen: the app's own channel and its entries in Watch Next (data/TvHome.kt). -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- Scanning the QR code a TV shows, to sign it in. Asked for at that moment only; typing the code works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- A controller is enough to play a game: nobody needs a touch screen or a gamepad to install the app. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- One app for phones, tablets and TVs: nothing here is required of the device. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- A TV has no camera, and must still be able to install the app. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Moonlight, a separate app, plays games on someone's own PC. Android 11 and later hide
         other apps unless they're named here. -->
    <queries>
        <package android:name="com.limelight" />
        <!-- The device's speech recogniser, for searching by voice. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- The TV's home screen, which is lent the pictures of what the app puts on it. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- allowBackup=false stops cloud backup. dataExtractionRules also stops the device-to-device
         transfer on Android 12 and later, which ignores allowBackup. -->
    <application
        android:name=".WittyApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:appCategory="video"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="WittyMediaClient"
        android:networkSecurityConfig="@xml/network_security"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- No links lead in, so no web page can open a screen here by address. A card the app put on a TV's
             home screen names this activity outright and says which title to open (data/TvHome.kt): only a
             title's page or playing a title is taken from it, on the server already signed in to. An
             empty task affinity keeps another app from placing itself in this app's task. The launch theme shows the
             mark while the app starts (values-v31 hands it to Android 12's own splash); onCreate puts AppTheme back. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:supportsPictureInPicture="false"
            android:theme="@style/AppTheme.Launch"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- An album's booklet, lent to the device's PDF reader while it's open: nothing else is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- Exported so that the system's media controls, headphones and a TV's card can reach it. Other apps
             can only press its buttons: ListeningService.Callback.onConnect. -->
        <service
            android:name=".player.ListeningService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
