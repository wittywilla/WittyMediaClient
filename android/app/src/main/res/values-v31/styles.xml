<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own splash, from these: the app's background and the client's mark, sized
         for the splash's icon area (drawable/splash_icon, made by scripts/sync-brand.sh). -->
    <style name="AppTheme.Launch">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
