<?xml version="1.0" encoding="utf-8"?>
<!-- WittyTV's channel on the whole screen: a surface view, as the films' player has. A texture view (tv_live_picture.xml,
     for the guide's rounded preview) was drawn at the stream's own size in the top-left corner on Android TV (#74). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:shutter_background_color="#000000" />
