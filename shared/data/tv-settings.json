{
  "about": "The desktop Settings pages a TV draws itself (docs/TV-SETTINGS-PARITY.md), in the shape of a module's settings (the server's docs/SDUI-MODULES.md) with where each value is kept. Text is a key in strings.en.json.",
  "stores": {
    "server": {
      "get": "/settings",
      "put": "/settings",
      "write": "patch",
      "admin": true
    },
    "ui": {
      "get": "/me/ui",
      "put": "/me/ui",
      "write": "merge"
    },
    "streaming": {
      "get": "/me/streaming",
      "put": "/me/streaming",
      "write": "merge",
      "root": "prefs"
    },
    "about": {
      "get": "/about"
    }
  },
